{
  "rewrites": [
    { "source": "/", "destination": "/website/index.html" },
    { "source": "/site.css", "destination": "/website/site.css" },
    { "source": "/site.js", "destination": "/website/site.js" },
    { "source": "/desktop", "destination": "/website/tool.html" },
    { "source": "/desktop/", "destination": "/website/tool.html" },
    { "source": "/desktop/:path*", "destination": "/website/tool/:path*" },
    { "source": "/tool", "destination": "/website/tool.html" },
    { "source": "/tool/", "destination": "/website/tool.html" },
    { "source": "/tool/:path*", "destination": "/website/tool/:path*" }
  ]
}
